diff --git a/sfe.c b/sfe.c
index 66c6187..75f180c 100644
--- a/sfe.c
+++ b/sfe.c
@@ -39,7 +39,51 @@
 
 extern int max_ipv4_conn;
 extern int max_ipv6_conn;
-extern bool fast_tc_filter;
+bool fast_tc_filter = false;
+typedef int (*athrs_fast_nat_recv_fn_t)(struct sk_buff *skb);
+static athrs_fast_nat_recv_fn_t *sfe_fast_nat_recv_p;
+int sfe_recv(struct sk_buff *skb);
+
+static unsigned int sfe_ipv4_pre_routing_hook(void *priv,
+					      struct sk_buff *skb,
+					      const struct nf_hook_state *state)
+{
+	if (unlikely(!skb->dev))
+		skb->dev = state->in;
+	if (sfe_recv(skb))
+		return NF_STOLEN;
+	return NF_ACCEPT;
+}
+
+#if defined(SFE_SUPPORT_IPV6)
+static unsigned int sfe_ipv6_pre_routing_hook(void *priv,
+					      struct sk_buff *skb,
+					      const struct nf_hook_state *state)
+{
+	if (unlikely(!skb->dev))
+		skb->dev = state->in;
+	if (sfe_recv(skb))
+		return NF_STOLEN;
+	return NF_ACCEPT;
+}
+#endif
+
+static const struct nf_hook_ops sfe_prerouting_ops[] = {
+	{
+		.hook = sfe_ipv4_pre_routing_hook,
+		.pf = NFPROTO_IPV4,
+		.hooknum = NF_INET_PRE_ROUTING,
+		.priority = NF_IP_PRI_FIRST,
+	},
+#if defined(SFE_SUPPORT_IPV6)
+	{
+		.hook = sfe_ipv6_pre_routing_hook,
+		.pf = NFPROTO_IPV6,
+		.hooknum = NF_INET_PRE_ROUTING,
+		.priority = NF_IP6_PRI_FIRST,
+	},
+#endif
+};
 uint8_t sfe_fls_flush_on_hwm_enable;
 
 #define SFE_MESSAGE_VERSION 0x1
@@ -2870,8 +2914,18 @@ int sfe_init_if(void)
 	/*
 	 * Hook the receive path in the network stack.
 	 */
-	BUG_ON(athrs_fast_nat_recv);
-	RCU_INIT_POINTER(athrs_fast_nat_recv, sfe_recv);
+	sfe_fast_nat_recv_p = (athrs_fast_nat_recv_fn_t *)__symbol_get("athrs_fast_nat_recv");
+	if (sfe_fast_nat_recv_p) {
+		RCU_INIT_POINTER(*sfe_fast_nat_recv_p, sfe_recv);
+		pr_info("sfe: kernel fast_nat_recv hook activated\n");
+	} else {
+		result = nf_register_net_hooks(&init_net, sfe_prerouting_ops, ARRAY_SIZE(sfe_prerouting_ops));
+		if (result) {
+			pr_err("sfe: failed to register netfilter hook: %d\n", result);
+			goto exit2;
+		}
+		pr_info("sfe: netfilter prerouting hook activated (generic kernel mode)\n");
+	}
 
 	return 0;
 exit2:
@@ -2890,7 +2944,14 @@ void sfe_exit_if(void)
 	/*
 	 * Unregister our receive callback.
 	 */
-	RCU_INIT_POINTER(athrs_fast_nat_recv, NULL);
+	if (sfe_fast_nat_recv_p) {
+		RCU_INIT_POINTER(*sfe_fast_nat_recv_p, NULL);
+		synchronize_rcu();
+		__symbol_put("athrs_fast_nat_recv");
+		sfe_fast_nat_recv_p = NULL;
+	} else {
+		nf_unregister_net_hooks(&init_net, sfe_prerouting_ops, ARRAY_SIZE(sfe_prerouting_ops));
+	}
 
 	sfe_pppoe_mgr_exit();
 
diff --git a/sfe_ipv4.c b/sfe_ipv4.c
index 46421b6..20043e6 100644
--- a/sfe_ipv4.c
+++ b/sfe_ipv4.c
@@ -2599,6 +2599,28 @@ sfe_response_t sfe_ipv4_create_rule(struct sfe_ipv4_rule_create_msg *msg)
 		return_interface_num = msg->conn_rule.return_interface_num;
 	}
 
+	/*
+	 * Check for an existing flow before taking any device reference or
+	 * allocating anything: a packet that the fast path could not take keeps
+	 * asking for the same rule, so that case must not cost two device lookups
+	 * and three atomic allocations.  Nothing is held at this point, so this
+	 * can return straight away.  The check further down is kept for the
+	 * concurrent create race.
+	 */
+	spin_lock_bh(&si->lock);
+	c_old = sfe_ipv4_find_connection(si, msg->tuple.protocol,
+					msg->tuple.flow_ip,
+					msg->tuple.flow_ident,
+					msg->tuple.return_ip,
+					msg->tuple.return_ident);
+	if (c_old != NULL) {
+		this_cpu_inc(si->stats_pcpu->connection_create_collisions64);
+		sfe_ipv4_update_protocol_state(c_old, msg);
+		spin_unlock_bh(&si->lock);
+		return SFE_RET_CONN_ALREADY_EXISTS;
+	}
+	spin_unlock_bh(&si->lock);
+
 	src_dev = dev_get_by_index(&init_net, flow_interface_num);
 	if (!src_dev) {
 		DEBUG_WARN("%px: Unable to find src_dev corresponding to %d\n", msg,
@@ -3977,7 +3999,9 @@ another_round:
 		 */
 		if (!dev
 		    || (dev == c->original_dev)
-		    || (dev == c->reply_dev)) {
+		    || (dev == c->reply_dev)
+		    || (c->original_match && dev == c->original_match->top_interface_dev)
+		    || (c->reply_match && dev == c->reply_match->top_interface_dev)) {
 			break;
 		}
 	}
@@ -3996,6 +4020,13 @@ another_round:
 	}
 }
 
+/*
+ * The connection manager needs to drop the flows of a device when it goes down,
+ * and those flows can be attached to a stacked device (the top interface, e.g.
+ * pppoe-wan) rather than to the device the packet entered or left through.
+ */
+EXPORT_SYMBOL(sfe_ipv4_destroy_all_rules_for_dev);
+
