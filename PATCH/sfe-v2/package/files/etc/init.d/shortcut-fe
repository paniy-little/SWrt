#!/bin/sh /etc/rc.common

START=70

start() {
	# Check if Shortcut-FE is enabled in firewall configuration
	[ "$(uci -q get firewall.@defaults[0].shortcut_fe)" != "1" ] && return 0

	# Load SFE v2 engine and connection manager modules
	modprobe qca-nss-sfe 2>/dev/null
	modprobe shortcut-fe-cm 2>/dev/null

	# Optimize TCP conntrack behavior for SFE
	echo 1 > /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 2>/dev/null
}

stop() {
	# Unload connection manager and engine modules cleanly
	rmmod shortcut-fe-cm 2>/dev/null || rmmod shortcut_fe_cm 2>/dev/null
	rmmod qca-nss-sfe 2>/dev/null || rmmod qca_nss_sfe 2>/dev/null

	# Reset TCP conntrack setting
	echo 0 > /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 2>/dev/null
}

restart() {
	stop
	start
}
