#!/bin/sh
# =============================================================================
# SELF/X86 首次启动网络初始化
#
# 设计原则：
#   - uci-defaults 脚本只在系统首次配置时运行一次，运行后自删除，
#     因此「升级固件 / 每次开机」都不会重复写入 /etc/config/network，
#     用户已有网络配置不会被覆盖。
#   - 若 /etc/config/network 中已存在可用的 lan/wan（含用户配置），直接跳过。
#   - 支持通过 /etc/network.env 指定 WAN_MAC / LAN_MAC 做稳定 MAC 映射，
#     适用于 Hyper-V / KVM 中网卡枚举顺序不稳定的场景。
#   - 未指定 MAC 时，回退到「第一块物理网卡 = WAN，第二块 = LAN」，
#     仅对全新安装生效。
# =============================================================================

# 可选的环境变量：WAN_MAC / LAN_MAC（格式：xx:xx:xx:xx:xx:xx）
# 由维护者在 /etc/network.env 中提供，SELF 不默认写入。
if [ -f /etc/network.env ]; then
    . /etc/network.env
fi

# 已存在用户配置：绝不覆盖
lan_device="$(uci -q get network.lan.device)"
wan_device="$(uci -q get network.wan.device)"
if [ -n "$lan_device" ] || [ -n "$wan_device" ]; then
    exit 0
fi

# 收集物理以太网接口（按枚举顺序），跳过虚拟接口
ifaces=""
for d in /sys/class/net/*; do
    [ -d "$d" ] || continue
    name="${d##*/}"
    case "$name" in
        lo | br-* | docker0 | veth* | tun* | tap* | vnet* | virbr*)
            continue
            ;;
    esac
    ifaces="$ifaces $name"
done

# 根据 MAC 解析接口名（MAC 比较统一转小写）
mac_to_iface() {
    mac="$(printf '%s' "$1" | tr 'A-Z' 'a-z')"
    for d in /sys/class/net/*; do
        [ -f "$d/address" ] || continue
        name="${d##*/}"
        addr="$(cat "$d/address" 2>/dev/null)"
        addr="$(printf '%s' "$addr" | tr 'A-Z' 'a-z')"
        [ "$addr" = "$mac" ] && { echo "$name"; return 0; }
    done
    return 1
}

wan=""
lan=""
# 用户显式指定 MAC：若解析不到，绝不静默回退到其它接口。
# 且这是“显式配置但无效”，必须 exit 1 让 uci-defaults 保留脚本，
# 用户修正 /etc/network.env 后下一次启动可重试。
explicit_error=0
if [ -n "${WAN_MAC:-}" ]; then
    wan="$(mac_to_iface "$WAN_MAC")"
    if [ -z "$wan" ]; then
        echo "ERROR: WAN_MAC '$WAN_MAC' not found among physical NICs; keeping uci-defaults for retry." >&2
        explicit_error=1
    fi
fi
if [ -n "${LAN_MAC:-}" ]; then
    lan="$(mac_to_iface "$LAN_MAC")"
    if [ -z "$lan" ]; then
        echo "ERROR: LAN_MAC '$LAN_MAC' not found among physical NICs; keeping uci-defaults for retry." >&2
        explicit_error=1
    fi
fi

# 回退：仅在用户未显式指定时，才使用“第一块网卡 WAN、第二块网卡 LAN”
first=""
second=""
for i in $ifaces; do
    if [ -z "$first" ]; then
        first="$i"
    elif [ -z "$second" ]; then
        second="$i"
        break
    fi
done
[ -n "${WAN_MAC:-}" ] || wan="${wan:-$first}"
[ -n "${LAN_MAC:-}" ] || lan="${lan:-$second}"

# WAN/LAN 解析或回退到同一接口
if [ -n "$wan" ] && [ -n "$lan" ] && [ "$wan" = "$lan" ]; then
    if [ -n "${WAN_MAC:-}" ] || [ -n "${LAN_MAC:-}" ]; then
        echo "ERROR: WAN_MAC / LAN_MAC map to the same interface '$wan'; invalid explicit mapping." >&2
        exit 1
    fi
    echo "WARNING: only one NIC available; skipping auto-init." >&2
    exit 0
fi

# 显式配置无效：保留 uci-defaults 脚本，用户修正后下一次启动可重试
if [ "$explicit_error" -ne 0 ]; then
    echo "ERROR: explicit VM network mapping is invalid" >&2
    exit 1
fi

# 至少要有一块网卡才初始化
[ -n "$lan" ] || exit 0

# 设置 LAN（config_generate 已创建默认 lan，这里只校正设备）
uci -q batch <<EOF
set network.lan.device="$lan"
EOF

# WAN：若不存在则创建（proto dhcp）
if [ -n "$wan" ]; then
    if ! uci -q get network.wan >/dev/null 2>&1; then
        uci -q batch <<EOF
set network.wan=interface
set network.wan.proto='dhcp'
set network.wan.device="$wan"
EOF
    else
        uci -q batch <<EOF
set network.wan.device="$wan"
EOF
    fi
fi

uci -q commit network
exit 0