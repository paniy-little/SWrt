#!/bin/sh
# =============================================================================
# SELF/X86 覆盖版：Hyper-V hv_netvsc ring 默认调优（RX/TX = 1024/1024）
#
# 说明：
#   - 本文件位于 SELF/X86/common/files，覆盖 PATCH/files 同名脚本（仅 X86 生效，
#     Rockchip 行为不受影响）。
#   - 只对 driver == hv_netvsc 处理。virtio/e1000/igc/ixgbe/物理 PCI NIC 全部
#     保持 driver/upstream 默认，绝不改动。
#   - 目标：当 ethtool -g 证明 Pre-set maximums 支持时才设 RX=1024 / TX=1024。
#     某方向 maximum < 1024 则保持当前值，绝不设置超出 maximum。
#   - 不再做：driver maximum、adaptive-rx on、adaptive-tx on、对所有 Ethernet NIC 处理。
#   - 若驱动不支持 ethtool -G 或解析失败：安全 no-op，不影响启动。
#   - 诊断请用只读工具 swrt-vm-perf 观察队列 / RSS / offload / softnet。
# =============================================================================

[ "$ACTION" = "add" ] || exit 0
[ -z "$DEVICENAME" ] && exit 0

command -v ethtool >/dev/null 2>&1 || exit 0

NIC="$DEVICENAME"

[ ! -d "/sys/class/net/$NIC/device" ] && exit 0
[ "$(cat "/sys/class/net/$NIC/type" 2>/dev/null)" != "1" ] && exit 0

# 只处理 hv_netvsc
DRIVER="$(ethtool -i "$NIC" 2>/dev/null | awk -F: '/^driver:/ {gsub(/^ +| +$/,"",$2); print $2; exit}')"
if [ "$DRIVER" != "hv_netvsc" ]; then
    exit 0
fi

# 解析 Pre-set maximums 中的 RX/TX（明确取 maximum 部分，不误拿 Current settings）
read -r RX_MAX TX_MAX <<EOF
$(ethtool -g "$NIC" 2>/dev/null | awk '/Pre-set maximums:/{in=1; next} /Current hardware settings:/{in=0} in && /^RX:/{rx=$2} in && /^TX:/{tx=$2} END{print rx+0, tx+0}')
EOF

# 解析失败：no-op + 日志，不修改
if [ -z "$RX_MAX" ] || [ -z "$TX_MAX" ] || [ "$RX_MAX" = "0" ] || [ "$TX_MAX" = "0" ]; then
    logger -t net-buffer "SWrt: cannot parse pre-set maximums for $NIC; safe no-op"
    exit 0
fi

# 目标 ring = 1024 / 1024，但绝不超出 maximum
RX_TARGET=1024
TX_TARGET=1024
[ "$RX_MAX" -lt "$RX_TARGET" ] && RX_TARGET=""   # max < 1024 -> 保持当前
[ "$TX_MAX" -lt "$TX_TARGET" ] && TX_TARGET=""   # max < 1024 -> 保持当前

if [ -n "$RX_TARGET" ]; then
    ethtool -G "$NIC" rx "$RX_TARGET" >/dev/null 2>&1
fi
if [ -n "$TX_TARGET" ]; then
    ethtool -G "$NIC" tx "$TX_TARGET" >/dev/null 2>&1
fi

# read-back：重新读取 Current hardware settings 的真实当前值，按实际结果记录，
# 不能因为 ethtool -G 静默失败而写假成功日志。
# 明确区分 Pre-set maximums 与 Current hardware settings，只读第二段。
read -r RX_ACTUAL TX_ACTUAL <<EOF
$(ethtool -g "$NIC" 2>/dev/null | awk '/Current hardware settings:/{in=1; next} in && /^RX:/{rx=$2} in && /^TX:/{tx=$2} END{print rx+0, tx+0}')
EOF

# 若连 read-back 都无法解析：安全 no-op，不阻塞启动
if [ -z "$RX_ACTUAL" ] || [ -z "$TX_ACTUAL" ]; then
    logger -t net-buffer "SWrt Hyper-V NIC tuning: $NIC cannot read back ring; safe no-op"
    exit 0
fi

# 判定每方向是否达到目标（无目标时"keep"视为满足）
RX_OK="${RX_ACTUAL}"
[ -n "$RX_TARGET" ] && [ "$RX_ACTUAL" -lt "$RX_TARGET" ] && RX_OK=""
TX_OK="${TX_ACTUAL}"
[ -n "$TX_TARGET" ] && [ "$TX_ACTUAL" -lt "$TX_TARGET" ] && TX_OK=""

if [ -n "$RX_OK" ] && [ -n "$TX_OK" ]; then
    logger -t net-buffer "SWrt Hyper-V NIC tuning: $NIC requested rx ${RX_TARGET:-keep} tx ${TX_TARGET:-keep} actual rx=${RX_ACTUAL} tx=${TX_ACTUAL} [OK]"
else
    logger -t net-buffer "SWrt Hyper-V NIC tuning: $NIC requested rx ${RX_TARGET:-keep} tx ${TX_TARGET:-keep} actual rx=${RX_ACTUAL} tx=${TX_ACTUAL} [WARN]"
fi
exit 0