#!/bin/sh
# =============================================================================
# swrt-vm-perf — SWrt x86 VM 网络性能只读诊断工具
#
# 设计原则：
#   - 默认【只读】。绝不自动修改 IRQ affinity / RPS / XPS / ring size /
#     coalescing / sysctl / firewall / SFE / software flow offload / CPU governor。
#   - 兼容 BusyBox /bin/sh（ash），不依赖 Bash 特性。
#   - 任何一块网卡或子系统不支持时，输出 "unsupported" 并继续，绝不报错退出。
#   - 判断保持克制：只有证据充分才给 OK / WARN，否则给 INFO。
#
# 用法：
#   swrt-vm-perf
# =============================================================================

# 所有 ethtool 调用都要求 ethtool 存在；缺失时统一降级为 sysfs 观察。
HAS_ETHTOOL=0
command -v ethtool >/dev/null 2>&1 && HAS_ETHTOOL=1

# 安全读取文件，缺失时输出 fallback
read_file() {
    # $1 = path, $2 = fallback
    if [ -r "$1" ]; then
        cat "$1" 2>/dev/null
    else
        echo "${2:-n/a}"
    fi
}

echo "=== SWrt VM Performance Report ==="
echo

# ---------------------------------------------------------------------------
# 4.1 VM / CPU 基础信息 + Hyper-V 检测（拆分 virtualized / hyperv）
#
# virtualized：任何虚拟化证据（CPU hypervisor flag、DMI Virtual Machine、
#   VMware / KVM / QEMU / VirtualBox / Microsoft）。
# hyperv：必须满足 Microsoft / Hyper-V 专属证据，避免把 KVM/QEMU/VMware/VBox
#   误判成 Hyper-V。后续会根据 hyperv 是否成真决定是否走 Hyper-V 专属调优。
# ---------------------------------------------------------------------------
echo "Virtualization:"
virtualized="no"
hyperv="no"
hypervisor_name="unknown"

vendor="$(read_file /sys/class/dmi/id/sys_vendor)"
product="$(read_file /sys/class/dmi/id/product_name)"
if [ -n "$vendor" ] && [ "$vendor" != "n/a" ]; then
    echo "  dmi vendor: $vendor"
fi
if [ -n "$product" ] && [ "$product" != "n/a" ]; then
    echo "  dmi product: $product"
fi

# 1) virtualized：CPU hypervisor flag 或 DMI 虚拟化关键词
if grep -qi "hypervisor" /proc/cpuinfo 2>/dev/null; then
    virtualized="yes"
fi
case "$vendor:$product" in
    *Virtual*|*VMware*|*KVM*|*QEMU*|*VirtualBox*|*Microsoft*|*Hyper-V*)
        virtualized="yes" ;;
esac

# 2) hypervisor 名称：从 cpuinfo hypervisor 字段或 DMI 推断
hypervisor_name="$(grep -m1 -oE 'hypervisor +: +[A-Za-z]+' /proc/cpuinfo 2>/dev/null | sed 's/.*hypervisor *: *//')"
case "$vendor:$product" in
    *Microsoft*|*Hyper-V*)
        [ "$hypervisor_name" = "unknown" ] && hypervisor_name="Hyper-V" ;;
    *VMware)  [ "$hypervisor_name" = "unknown" ] && hypervisor_name="VMware" ;;
    *KVM*|*QEMU*) [ "$hypervisor_name" = "unknown" ] && hypervisor_name="KVM/QEMU" ;;
    *VirtualBox*) [ "$hypervisor_name" = "unknown" ] && hypervisor_name="VirtualBox" ;;
esac

# 3) hyperv：仅接受 Microsoft / Hyper-V 专属证据（任一即可）
hv_evidence=""
# 3a) DMI vendor == Microsoft Corporation
if [ -n "$vendor" ] && printf '%s' "$vendor" | grep -qi "Microsoft"; then
    hv_evidence="$hv_evidence dmi-vendor-microsoft"
fi
# 3b) cpuinfo / dmesg 出现 Microsoft Hv
if grep -qiE "Microsoft Hv|Hyper-V" /proc/cpuinfo 2>/dev/null; then
    hv_evidence="$hv_evidence cpuinfo-hyperv"
fi
if command -v dmesg >/dev/null 2>&1 && dmesg 2>/dev/null | grep -qiE "Hyper-V|hv_vmbus"; then
    hv_evidence="$hv_evidence dmesg-hyperv"
fi
# 3c) hv_vmbus 模块存在
if [ -d /sys/bus/vmbus ] || grep -qi "hv_vmbus" /proc/modules 2>/dev/null; then
    hv_evidence="$hv_evidence hv_vmbus"
fi
# 3d) 至少一块 driver=hv_netvsc 的 NIC
for d in /sys/class/net/*; do
    [ -d "$d" ] || continue
    name="${d##*/}"
    case "$name" in lo|br-*|docker*|veth*|tun*|tap*|vnet*|virbr*) continue;; esac
    drv="$(basename "$(readlink "$d/device/driver" 2>/dev/null)")"
    if [ "$drv" = "hv_netvsc" ]; then
        hv_evidence="$hv_evidence netvsc"
        break
    fi
done
[ -n "$hv_evidence" ] && hyperv="yes"

[ "$virtualized" = "yes" ] && [ "$hypervisor_name" = "unknown" ] && hypervisor_name="virtualized"
echo "  virtualized: $virtualized"
echo "  hypervisor: $hypervisor_name"
echo "  Hyper-V detected: $hyperv${hv_evidence:+ (evidence:$hv_evidence)}"
echo

echo "CPU:"
vcpus=0
for c in /sys/devices/system/cpu/cpu[0-9]*; do
    [ -d "$c" ] && vcpus=$((vcpus + 1))
done
[ "$vcpus" -eq 0 ] && vcpus="$(nproc 2>/dev/null || echo unknown)"
echo "  vCPU count: $vcpus"
echo "  architecture: $(uname -m 2>/dev/null || echo unknown)"
echo

# ---------------------------------------------------------------------------
# 枚举真实 Ethernet NIC（跳过虚拟/容器接口）
# ---------------------------------------------------------------------------
NICS=""
for d in /sys/class/net/*; do
    [ -d "$d" ] || continue
    name="${d##*/}"
    case "$name" in
        lo|br-*|docker*|veth*|tun*|tap*|vnet*|virbr*)
            continue ;;
    esac
    # 优先保留带真实 device/driver 的接口
    [ -d "$d/device" ] && NICS="$NICS $name"
done
# 如果靠 device 目录一个都没找到，退化为全部非虚拟接口
if [ -z "$NICS" ]; then
    for d in /sys/class/net/*; do
        [ -d "$d" ] || continue
        name="${d##*/}"
        case "$name" in
            lo|br-*|docker*|veth*|tun*|tap*|vnet*|virbr*) continue;;
        esac
        NICS="$NICS $name"
    done
fi

if [ -z "$NICS" ]; then
    echo "No physical Ethernet NIC found."
    echo
fi

# ---------------------------------------------------------------------------
# NIC 级观察循环
# ---------------------------------------------------------------------------
# 记录 hv_netvsc NIC 的队形，供 Recommendations 判断 RPS 是否该用。
netvsc_nic=0     # hv_netvsc NIC 数量
netvsc_multi=0   # 存在任意多 RX queue 的 hv_netvsc NIC 数量
netvsc_single=0  # 存在单 RX queue 的 hv_netvsc NIC 数量
for iface in $NICS; do
    echo "=== NIC: $iface ==="
    echo "  MAC: $(read_file "/sys/class/net/$iface/address" n/a)"
    link="$(read_file "/sys/class/net/$iface/operstate" n/a)"
    echo "  link state: $link"

    # driver：优先 ethtool -i，失败退回 sysfs
    drv="n/a"
    if [ "$HAS_ETHTOOL" = "1" ]; then
        drv="$(ethtool -i "$iface" 2>/dev/null | awk -F: '/^driver:/ {gsub(/^ +| +$/,"",$2); print $2; exit}')"
    fi
    [ -z "$drv" ] && drv="n/a"
    if [ "$drv" = "n/a" ]; then
        drv="$(basename "$(readlink "/sys/class/net/$iface/device/driver" 2>/dev/null)")"
    fi
    echo "  driver: ${drv:-unknown}"

    if [ "$HAS_ETHTOOL" = "1" ]; then
        speed="$(ethtool "$iface" 2>/dev/null | awk -F: '/^[[:space:]]*Speed:/ {gsub(/^ +| +$/,"",$2); print $2; exit}')"
        [ -n "$speed" ] && echo "  speed: $speed"
    fi

    # --- 4.3 queue 与 RSS ---
    rx_q="$(ls -d "/sys/class/net/$iface/queues/"rx-* 2>/dev/null | wc -l | tr -d ' ')"
    tx_q="$(ls -d "/sys/class/net/$iface/queues/"tx-* 2>/dev/null | wc -l | tr -d ' ')"
    echo "  RX queue count: ${rx_q:-0} (sysfs)"
    echo "  TX queue count: ${tx_q:-0} (sysfs)"
    if [ "$HAS_ETHTOOL" = "1" ] && ethtool -l "$iface" >/dev/null 2>&1; then
        echo "  ethtool -l (combined):"
        ethtool -l "$iface" 2>/dev/null | sed 's/^/    /'
    else
        echo "  ethtool -l: unsupported"
    fi
    if [ "$HAS_ETHTOOL" = "1" ] && ethtool -x "$iface" >/dev/null 2>&1; then
        echo "  ethtool -x (RSS indirection):"
        ethtool -x "$iface" 2>/dev/null | sed 's/^/    /'
    else
        echo "  ethtool -x: unsupported"
    fi
    if [ "${rx_q:-0}" -gt 1 ]; then
        echo "  [OK] multiple RX queues detected"
    else
        echo "  [INFO] single RX queue detected"
    fi

    # 记录 hv_netvsc 队形（供 Recommendations 判断 RPS）
    if [ "$drv" = "hv_netvsc" ]; then
        netvsc_nic=$((netvsc_nic + 1))
        if [ "${rx_q:-0}" -gt 1 ]; then
            netvsc_multi=$((netvsc_multi + 1))
        else
            netvsc_single=$((netvsc_single + 1))
        fi
    fi

    # --- 4.4 offload 状态（只报告，不强制修改）---
    if [ "$HAS_ETHTOOL" = "1" ] && ethtool -k "$iface" >/dev/null 2>&1; then
        echo "  offload (ethtool -k):"
        ethtool -k "$iface" 2>/dev/null | grep -E \
            "rx-checksumming|tx-checksumming|scatter-gather|tcp-segmentation-offload|generic-segmentation-offload|generic-receive-offload|large-receive-offload" \
            | sed 's/^/    /'
    else
        echo "  offload: unsupported (ethtool missing or driver)"
    fi

    # --- 4.6 RPS / XPS 只观察 ---
    echo "  RPS masks (rx-*/rps_cpus):"
    rps_found=0
    for q in "/sys/class/net/$iface/queues/"rx-*; do
        [ -r "$q/rps_cpus" ] || continue
        rps_found=1
        echo "    $(basename "$q"): $(read_file "$q/rps_cpus" 0)"
    done
    [ "$rps_found" = "0" ] && echo "    none"
    echo "  XPS masks (tx-*/xps_cpus):"
    xps_found=0
    for q in "/sys/class/net/$iface/queues/"tx-*; do
        [ -r "$q/xps_cpus" ] || continue
        xps_found=1
        echo "    $(basename "$q"): $(read_file "$q/xps_cpus" 0)"
    done
    [ "$xps_found" = "0" ] && echo "    none"

    # --- 4.8 ring / coalescing 只观察 ---
    if [ "$HAS_ETHTOOL" = "1" ] && ethtool -g "$iface" >/dev/null 2>&1; then
        echo "  ring (ethtool -g):"
        ethtool -g "$iface" 2>/dev/null | sed 's/^/    /'
    else
        echo "  ring: unsupported"
    fi
    if [ "$HAS_ETHTOOL" = "1" ] && ethtool -c "$iface" >/dev/null 2>&1; then
        echo "  coalescing (ethtool -c):"
        ethtool -c "$iface" 2>/dev/null | sed 's/^/    /'
    else
        echo  "  coalescing: unsupported"
    fi
    echo
done

# ---------------------------------------------------------------------------
# 4.5 IRQ / softirq 分布（只提取网络相关，不整份 dump）
# ---------------------------------------------------------------------------
echo "=== IRQ / softirq ==="
if [ -r /proc/interrupts ]; then
    echo "-- /proc/interrupts (network-related) --"
    grep -iE "hv_netvsc|vmbus|Hyper-V|virtio" /proc/interrupts 2>/dev/null | sed 's/^/  /'
    # 从第一行确定 CPU 列数（CPU0 CPU1 ...），$1 是 IRQ label，故只累计 $2..$(cpu_count+1)
    cpu_count="$(awk 'NR==1{for(i=1;i<=NF;i++) if($i ~ /^CPU/) n++} END{print n+0}' /proc/interrupts 2>/dev/null)"
    if [ "${cpu_count:-0}" -lt 1 ]; then
        echo "  [INFO] unable to determine IRQ balance automatically"
    else
        # 仅累计 CPU counter 列，成对输出 "label 值" 供后续解析
        net_irq="$(grep -iE "hv_netvsc|vmbus|virtio" /proc/interrupts 2>/dev/null \
            | awk -v c="$cpu_count" '{for(i=2;i<=c+1;i++) s[i]+=$i; tot=0; for(i=2;i<=c+1;i++) tot+=$i; if(tot>0){printf $1; for(i=2;i<=c+1;i++) printf " %s", $i; printf "\n"}}')"
        if [ -z "$net_irq" ]; then
            echo "  [INFO] no network IRQ activity observed"
        else
            echo "  Network IRQ distribution (from /proc/interrupts):"
            # 汇总各 CPU 计数
            dist="$(echo "$net_irq" | awk -v c="$cpu_count" '{for(i=1;i<=c;i++) s[i]+=$((i+1)); tot=0; for(i=1;i<=c;i++) tot+=s[i]} END{for(i=1;i<=c;i++){printf "  CPU%d: %d\n", i-1, s[i]}}')"
            echo "$dist"
            # 判断是否均衡：最高 CPU 占比 > 80% 且总计数足够大 -> WARN
            verdict="$(echo "$net_irq" | awk -v c="$cpu_count" '{for(i=1;i<=c;i++) s[i]+=$((i+1)); tot=0; for(i=1;i<=c;i++) tot+=s[i]} END{ if(tot==0){print "zero"; exit} max=0; for(i=1;i<=c;i++) if(s[i]>max) max=s[i]; pct=max*100/tot; if(tot<1000) print "low"; else if(pct>80) print "conc"; else print "ok" }')"
            case "$verdict" in
                ok)  echo "  [OK] network IRQ activity is distributed across multiple CPUs" ;;
                conc) echo "  [WARN] network IRQ activity is strongly concentrated (max CPU > 80%)" ;;
                low) echo "  [INFO] network IRQ activity is too low to judge balance" ;;
                zero) echo "  [INFO] no network IRQ activity observed" ;;
            esac
        fi
    fi
else
    echo "  /proc/interrupts: n/a"
fi

if [ -r /proc/softirqs ]; then
    echo "-- /proc/softirqs (NET_RX / NET_TX distribution) --"
    grep -E "^ *(NET_RX|NET_TX)" /proc/softirqs 2>/dev/null | sed 's/^/  /'
else
    echo "  /proc/softirqs: n/a"
fi
echo

# ---------------------------------------------------------------------------
# 4.7 Softnet congestion
#    /proc/net/softnet_stat 字段是十六进制文本（如 00000000），必须按 hex 解析，
#    不能再用 $2 != "0" 判断，否则真实 00000000 会被当作非零 drop。
# ---------------------------------------------------------------------------
echo "=== Softnet (netdev) congestion ==="
if [ -r /proc/net/softnet_stat ]; then
    echo "  (raw rows: [cpu] processed dropped time_squeeze ...)"
    awk '{ printf "  cpu %d processed=0x%s dropped=0x%s time_squeeze=0x%s\n", NR-1, $1, $2, $3 }' /proc/net/softnet_stat 2>/dev/null | head -n 8
    # BusyBox awk 可用的十六进制转十进制函数
    read -r soft_processed soft_dropped soft_squeeze <<EOF
$(awk 'function hex2dec(h,    i,c,v,n){
        h=tolower(h); sub(/^0x/,"",h); n=0;
        for(i=1;i<=length(h);i++){ c=substr(h,i,1); v=index("0123456789abcdef",c)-1;
            if(v<0) return -1; n=n*16+v }
        return n }
      { p+=hex2dec($1); d+=hex2dec($2); s+=hex2dec($3) }
      END{ printf "%d %d %d\n", p, d, s }' /proc/net/softnet_stat 2>/dev/null)
EOF
    echo "  processed total: ${soft_processed:-0}"
    echo "  dropped total: ${soft_dropped:-0}"
    echo "  time_squeeze total: ${soft_squeeze:-0}"
    if [ "${soft_dropped:-0}" = "0" ]; then
        echo "  [OK] no softnet drops observed"
    else
        echo "  [WARN] softnet drops observed: ${soft_dropped} (backlog/RSS/CPU distribution deserves testing)"
    fi
else
    echo "  /proc/net/softnet_stat: n/a"
fi
echo

# ---------------------------------------------------------------------------
# 4.9 当前 forwarding fast path 状态
# ---------------------------------------------------------------------------
echo "=== Forwarding fast path ==="
flow="$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)"
flow_hw="$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)"
sfe="$(uci -q get firewall.@defaults[0].shortcut_fe 2>/dev/null)"
sfe_mod="$(uci -q get firewall.@defaults[0].shortcut_fe_module 2>/dev/null)"
mode="Baseline / None"
if [ "$sfe" = "1" ]; then
    mode="Shortcut-FE (module: ${sfe_mod:-unknown})"
elif [ "$flow" = "1" ]; then
    if [ "$flow_hw" = "1" ]; then
        mode="Hardware Flow Offload"
    else
        mode="Software Flow Offload"
    fi
fi
echo "  current mode: $mode"
echo "  firewall.@defaults[0].flow_offloading=$flow"
echo "  firewall.@defaults[0].flow_offloading_hw=$flow_hw"
echo "  firewall.@defaults[0].shortcut_fe=$sfe"
echo "  firewall.@defaults[0].shortcut_fe_module=$sfe_mod"
echo

# ---------------------------------------------------------------------------
# 4.10 Conntrack 仅信息展示
# ---------------------------------------------------------------------------
echo "=== Conntrack (info only) ==="
if [ -r /proc/sys/net/netfilter/nf_conntrack_count ] && [ -r /proc/sys/net/netfilter/nf_conntrack_max ]; then
    echo "  nf_conntrack_count: $(cat /proc/sys/net/netfilter/nf_conntrack_count 2>/dev/null)"
    echo "  nf_conntrack_max: $(cat /proc/sys/net/netfilter/nf_conntrack_max 2>/dev/null)"
    echo "  [INFO] conntrack sizing is a capacity/reliability concern, not a direct packet-speed optimization."
else
    echo "  nf_conntrack: not exposed"
fi
echo

# ---------------------------------------------------------------------------
# 4.11 Recommendations —— 仅基于可证明的状态给建议，不做动静推断
# ---------------------------------------------------------------------------
echo "=== Recommendations ==="

# TCP 拥塞控制与 BBR3 可用性（供本机 endpoint A/B）
tcp_cc="$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null)"
bbr_avail="no"
if [ -r /proc/sys/net/ipv4/tcp_available_congestion_control ]; then
    grep -qi "bbr" /proc/sys/net/ipv4/tcp_available_congestion_control 2>/dev/null && bbr_avail="yes"
fi
echo "  current TCP CC: ${tcp_cc:-unknown}"
if [ "$bbr_avail" = "yes" ] && [ "$tcp_cc" != "bbr" ]; then
    echo "  [INFO] BBR3 is available for local-endpoint A/B testing (not forced)."
fi

# Packet steering 建议（基于 hv_netvsc 队形 + hyperv + vCPU）
if [ "$netvsc_multi" -gt 0 ]; then
    echo "  [OK] hv_netvsc multiqueue active; software RPS is not recommended."
elif [ "$netvsc_single" -gt 0 ]; then
    if [ "$hyperv" = "yes" ] && [ "${vcpus:-0}" -gt 1 ]; then
        echo "  [INFO] Hyper-V detected, ${vcpus} vCPU, single RX queue; Packet Steering auto mode is appropriate."
    else
        echo "  [INFO] single RX queue hv_netvsc; Packet Steering auto mode may be considered only if Hyper-V + multi-vCPU."
    fi
fi

# softnet drop delta 无法从单次快照推断
echo "  [OK] softnet dropped delta cannot be inferred from a one-time snapshot."
echo "  Use the A/B test script under load before increasing backlog."

echo
echo "=== End of report (read-only; nothing was modified) ==="
exit 0