### CRYPTO - Xray & Hardware Accelerated (No AVX) ###
# 核心加密框架与基础支持
CONFIG_PACKAGE_kmod-crypto-acompress=y
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-hash=y
CONFIG_PACKAGE_kmod-crypto-manager=y
CONFIG_PACKAGE_kmod-crypto-null=y
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-seqiv=y
CONFIG_PACKAGE_kmod-crypto-user=y

# 现代流加密与 Xray 常用算法 (VLESS/Trojan/TLS 1.3)
CONFIG_PACKAGE_kmod-crypto-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-chacha20poly1305=y
CONFIG_PACKAGE_kmod-crypto-lib-curve25519=y
CONFIG_PACKAGE_kmod-crypto-lib-poly1305=y
CONFIG_PACKAGE_kmod-crypto-ghash=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-sha512=y
CONFIG_PACKAGE_kmod-crypto-xts=y

# 额外添加的加密模块，用于OpenClash、MosDNS等应用
CONFIG_PACKAGE_kmod-crypto-ctr=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-cbc=y
CONFIG_PACKAGE_kmod-crypto-camellia=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha3=y

## 硬件加速优化：针对 AES-NI + SHA-NI (无 AVX 环境) ##

# 1. 开启 AES-NI 硬件加速 (核心优化)
CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-aesni=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_X86_64=y
CONFIG_CRYPTO_AES_NI_INTEL=y

# 2. 开启 SHA-NI 硬件加速 (针对你的 CPU flags: sha_ni)
# 显著降低 Xray 处理散列校验时的 CPU 占用
CONFIG_PACKAGE_kmod-crypto-sha256-ni=y
CONFIG_PACKAGE_kmod-crypto-sha1-ni=y

# 3. 启用 PCLMULQDQ 支持 (针对你的 CPU flags: pclmulqdq)
# 用于加速某些加密操作
CONFIG_PACKAGE_kmod-crypto-pclmulqdq=y

# 4. 启用硬件随机数生成支持 (针对你的 CPU flags: rdrand, rdseed)
# 提供更高质量的随机数和更好的性能
CONFIG_PACKAGE_kmod-crypto-rng=y
CONFIG_PACKAGE_kmod-crypto-rng-ccp=y

# 3. 彻底禁用导致报错的 AVX 指令集模块
# CONFIG_PACKAGE_kmod-crypto-aes-ni-avx is not set
# CONFIG_PACKAGE_kmod-crypto-aes-ni-avx2 is not set
# CONFIG_PACKAGE_kmod-crypto-camellia-aesni-avx-x86_64 is not set
# CONFIG_PACKAGE_kmod-crypto-camellia-aesni-avx2 is not set
# CONFIG_PACKAGE_kmod-crypto-serpent-avx-x86_64 is not set
# CONFIG_PACKAGE_kmod-crypto-serpent-avx2 is not set
# CONFIG_PACKAGE_kmod-crypto-twofish-avx-x86_64 is not set
# CONFIG_PACKAGE_kmod-crypto-cast5-avx-x86_64 is not set
# CONFIG_PACKAGE_kmod-crypto-cast6-avx-x86_64 is not set

